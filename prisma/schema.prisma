generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Profile {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String       @default("")
  description String       @default("")
  dateCreate  DateTime?    @map("date_create")
  dateUpdate  DateTime?    @map("date_update")
  skills      Skill[]
  experiences Experience[]
  projects    Project[]

  @@map("profiles")
}

model Skill {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  profileId  String    @map("profile_id") @db.ObjectId
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name       String    @default("")
  dateCreate DateTime? @map("date_create")
  dateUpdate DateTime? @map("date_update")

  @@index([profileId])
  @@map("skills")
}

model Experience {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  profileId  String    @map("profile_id") @db.ObjectId
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company    String    @default("")
  position   String    @default("")
  period     String    @default("")
  dateCreate DateTime? @map("date_create")
  dateUpdate DateTime? @map("date_update")

  @@index([profileId])
  @@map("experiences")
}

model Project {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  profileId  String    @map("profile_id") @db.ObjectId
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name       String    @default("")
  git        String    @default("")
  dateCreate DateTime? @map("date_create")
  dateUpdate DateTime? @map("date_update")

  @@index([profileId])
  @@map("projects")
}
